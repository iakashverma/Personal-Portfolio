# ============================================================
# Portfolio CMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Upstash Redis (Recommended — Free Tier) ---
# Create a free database at https://console.upstash.com
# Copy the REST URL and REST Token from the database details page.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=AYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin API Secret ---
# A random secret string used to authenticate admin write operations.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This prevents unauthorized users from modifying portfolio data.
ADMIN_API_SECRET=your-random-secret-string-here

# --- Admin Login Credentials (Optional) ---
# Override the default admin login email and password.
# If not set, defaults to admin@akku.com with the default hash.
# ADMIN_EMAIL=admin@akku.com
# ADMIN_PASSWORD=your-plain-text-admin-password
# ADMIN_PASS_HASH=50cf58d2a2363ed8b4b6a27075e5667816a36811f6f2e1be012b396c15567746

# ============================================================
# ALTERNATIVE DATABASE PROVIDERS (Optional — pick ONE)
# If you prefer a different provider, set those variables instead.
# The backend tries providers in this order:
# 1. Upstash Redis / Vercel KV
# 2. Supabase
# 3. GitHub Gist
# 4. JSONBin.io
# ============================================================

# --- Supabase (Alternative) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxx

# --- GitHub Gist (Alternative) ---
# GITHUB_GIST_ID=your-gist-id
# PORTFOLIO_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# --- JSONBin.io (Alternative) ---
# JSONBIN_BIN_ID=your-bin-id
# JSONBIN_API_KEY=$2b$xxxxxxxxxx
